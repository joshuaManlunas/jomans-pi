{
	"name": "pi-cursor-provider",
	"version": "0.1.0",
	"description": "Pi provider that runs Cursor models through the Cursor SDK local agent loop",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"cursor"
	],
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"test": "bun test extensions/cursor-provider",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"check": "npm run typecheck && npm run lint && npm test",
		"pack:check": "npm pack --dry-run"
	},
	"files": [
		"extensions/",
		"!extensions/**/*.test.ts",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/cursor-provider/index.ts"
		]
	},
	"dependencies": {
		"@cursor/sdk": "~1.0.32"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@earendil-works/pi-ai": "0.87.1",
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@earendil-works/pi-tui": "0.87.1",
		"@types/bun": "^1.3.0",
		"@types/node": "^22.19.0",
		"typescript": "~7.0.2"
	},
	"overrides": {
		"@connectrpc/connect-node@1.7.0": {
			"undici": "6.29.0"
		}
	}
}
